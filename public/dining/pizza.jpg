<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 360" width="640" height="360">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#D32F2F" />
      <stop offset="50%" stop-color="#BF360C" />
      <stop offset="100%" stop-color="#3E2723" />
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-opacity="0.25" />
    </filter>
  </defs>
  
  <rect width="640" height="360" fill="url(#bg)" />
  
  <!-- Subtle pattern -->
  <g opacity="0.08" stroke="#FFFFFF" stroke-width="1.5" fill="none">
    <circle cx="320" cy="180" r="140" />
    <circle cx="320" cy="180" r="170" stroke-dasharray="8 8" />
  </g>
  
  <!-- Center Graphic: Italian Artisan Pizza Slice & Basil -->
  <g filter="url(#shadow)" transform="translate(320, 150)">
    <!-- Pizza Pan / Board -->
    <circle cx="0" cy="0" r="70" fill="#D7CCC8" stroke="#8D6E63" stroke-width="2" />
    <circle cx="0" cy="0" r="62" fill="#FFA000" stroke="#FF8F00" stroke-width="3" /> <!-- Crust -->
    <circle cx="0" cy="0" r="54" fill="#E53935" /> <!-- Tomato sauce -->
    <circle cx="0" cy="0" r="48" fill="#FFF9C4" opacity="0.9" /> <!-- Melted Cheese -->
    
    <!-- Pepperoni / Toppings -->
    <circle cx="-18" cy="-18" r="9" fill="#B71C1C" stroke="#D32F2F" stroke-width="1.5" />
    <circle cx="20" cy="-15" r="8" fill="#B71C1C" stroke="#D32F2F" stroke-width="1.5" />
    <circle cx="0" cy="18" r="10" fill="#B71C1C" stroke="#D32F2F" stroke-width="1.5" />
    <circle cx="-22" cy="12" r="7" fill="#B71C1C" stroke="#D32F2F" stroke-width="1.5" />
    <circle cx="22" cy="14" r="8" fill="#B71C1C" stroke="#D32F2F" stroke-width="1.5" />

    <!-- Basil Leaves -->
    <path d="M-5,-6 C-12,-15 2,-20 5,-10 C7,-2 -2,0 -5,-6 Z" fill="#388E3C" />
    <path d="M8,5 C15,-2 18,12 8,14 C2,15 4,10 8,5 Z" fill="#388E3C" />
    
    <!-- Olive rings -->
    <circle cx="-5" cy="-2" r="4" fill="none" stroke="#212121" stroke-width="2" />
    <circle cx="8" cy="-24" r="4" fill="none" stroke="#212121" stroke-width="2" />
  </g>
  
  <!-- Typography Badge -->
  <rect x="175" y="270" width="290" height="42" rx="21" fill="#FFFFFF" fill-opacity="0.95" filter="url(#shadow)" />
  <text x="320" y="296" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="16" font-weight="800" fill="#BF360C" text-anchor="middle" letter-spacing="0.5">
    PIZZA & ITALIAN
  </text>
</svg>
